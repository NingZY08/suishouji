JWT_SECRET=your-jwt-secret-key

# AI 配置加密密钥（32字节 hex，64个十六进制字符；生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
# 注意：必须与写入数据库记录时所用的密钥一致，否则已保存的 API Key 将无法解密
AI_ENCRYPT_KEY=your-ai-encrypt-key-64-hex-chars

# cloudsqlpub MySQL 数据库配置
CLOUDSQLPUB_DB_DIALECT=your-dialect
CLOUDSQLPUB_DB_HOST=your-db-host
CLOUDSQLPUB_DB_PORT=your-db-port
CLOUDSQLPUB_DB_USER=your-db-user
CLOUDSQLPUB_DB_PASSWORD=your-db-password
CLOUDSQLPUB_DB_NAME=your-db-name

# Cloudflare R2 配置
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
R2_DOMAIN=your-r2-public-domain
