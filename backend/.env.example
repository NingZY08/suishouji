JWT_SECRET=your-jwt-secret-key

# cloudsqlpub MySQL 数据库配置
CLOUDSQLPUB_DB_DIALECT=your-dialect
CLOUDSQLPUB_DB_HOST=your-db-host
CLOUDSQLPUB_DB_PORT=your-db-port
CLOUDSQLPUB_DB_USER=your-db-user
CLOUDSQLPUB_DB_PASSWORD=your-db-password
CLOUDSQLPUB_DB_NAME=your-db-name

# Cloudflare R2 配置
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
R2_DOMAIN=your-r2-public-domain
